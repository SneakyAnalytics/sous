ANTHROPIC_API_KEY=
# claude-sonnet-5-5 by default; set claude-opus-5-5 for the most careful chef
ANTHROPIC_MODEL=claude-sonnet-5-5
# mock = fake products (safe for testing). mcp = drive the real safeway.com via @striderlabs/mcp-safeway.
SAFEWAY_MODE=mock
SAFEWAY_EMAIL=
SAFEWAY_PASSWORD=
# Google Calendar (optional): path to a copy of token_jake.pickle from Task_Chore_Syncing. Sous reads it, never writes it.
GOOGLE_TOKEN_PATH=
# Where recipe links in calendar events point. On the Beelink the deploy script sets this to its Tailscale address.
SOUS_URL=http://localhost:3100
