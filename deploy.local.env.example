# Copy to deploy.local.env (git-ignored). Same server as fitness_tracker; a Tailscale name works from anywhere.
BEELINK_HOST=your-server-address
BEELINK_USER=your-windows-username
BEELINK_HOME=C:/Users/your-windows-username

# Optional: Google Calendar. Full path on the server to the token Task_Chore_Syncing keeps (forward slashes).
# Sous reads it read-only and never writes it back.
GOOGLE_TOKEN_FILE_ON_BEELINK=C:/Automations/Task_Chore_Syncing/token_jake.pickle
